{
  "name": "zeno",
  "displayName": "Zeno",
  "description": "The Zeno language: colours, and mistakes shown as you type",
  "version": "0.0.1",
  "publisher": "zeno-lang",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zeno",
        "aliases": ["Zeno", "zeno"],
        "extensions": [".zeno"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zeno",
        "scopeName": "source.zeno",
        "path": "./syntaxes/zeno.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Zeno",
      "properties": {
        "zeno.path": {
          "type": "string",
          "default": "zeno",
          "description": "The `zeno` program to start as the language server. Give its full path if it is not on your PATH."
        }
      }
    },
    "configurationDefaults": {
      "[zeno]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
