# tour.zeno: a sketch of what Zeno might look like.
# Rule of thumb: if Python has a way to say it, Zeno says it the same way.
# Borrowed syntax is marked with [Rust] or [Java]. Nothing here is final.


# --- Variables: no keyword, types are worked out for you ---

name = "Zeno"
count = 3
ratio = 0.5
ports: list[int] = [80, 443, 8080]     # write the type only when you want to

const PI = 3.14159                     # [Java/C] a value that can never change


# --- Functions: Python's def, with type hints that are actually checked ---

def greet(who: str, excited: bool = False) -> str:
    if excited:
        return f"Hello, {who}!"
    return f"Hello, {who}."


# --- Classes: fields listed at the top, methods below ---

class Point:
    x: float
    y: float

    def distance_to(self, other: Point) -> float:
        return sqrt((self.x - other.x) ** 2 + (self.y - other.y) ** 2)

origin = Point(0.0, 0.0)
here = Point(x=3.0, y=4.0)


# --- Enums that carry data, and match to take them apart ---

enum Shape:                            # [Rust] each case can hold its own values
    Circle(radius: float)
    Rect(width: float, height: float)

def area(shape: Shape) -> float:
    match shape:                       # same as Python's match / case
        case Circle(r):
            return PI * r * r
        case Rect(w, h):
            return w * h
    # Forget a case and the compiler tells you, before the program ever runs.


# --- Errors: try / except / raise, but checked ---

def parse_port(text: str) -> int raises ValueError:    # [Java] errors are declared
    port = int(text)                   # int() may raise ValueError; it passes up
    if port < 1 or port > 65535:
        raise ValueError("port out of range")
    return port

try:
    port = parse_port("8080")
    print(f"listening on {port}")
except ValueError as err:
    print(f"error: {err}")
# Under the hood this is a plain return value, not stack unwinding,
# so it is cheap enough for a microcontroller.


# --- No surprise None ---

def find_user(id: int) -> str | None:
    if id == 1:
        return "partha"
    return None

user = find_user(2)
if user is not None:
    print(user.upper())                # allowed only inside this check


# --- Loops and comprehensions, straight from Python ---

for shape in [Circle(1.0), Rect(2.0, 3.0)]:
    print(f"area = {area(shape):.2f}")

squares = [n * n for n in range(10) if n % 2 == 0]
print(greet(name, excited=True), count, ratio, squares, origin.distance_to(here))
