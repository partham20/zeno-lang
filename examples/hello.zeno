# hello.zeno: a rough sketch of what Zeno might look like.
# Nothing here is final. The syntax will change as the language takes shape.

# Units are part of the type, so you can't add volts to milliseconds by accident.
const BLINK: Duration = 500 ms

enum Shape:
    Circle(radius: f32)
    Rect(w: f32, h: f32)

fn area(s: Shape) -> f32:
    match s:
        Circle(r)  => 3.14159 * r * r
        Rect(w, h) => w * h

# No null and no exceptions: failures come back as a Result.
fn parse_port(text: str) -> Result[u16, str]:
    let n = text.to_int()?            # `?` returns the error early
    if n < 1 or n > 65535:
        return Err("port out of range")
    return Ok(n as u16)

fn main():
    let name = "Zeno"                  # type inferred as str
    print("Hello from {name}!")

    let shapes = [Circle(1.0), Rect(2.0, 3.0)]
    for s in shapes:
        print("area = {area(s)}")

    match parse_port("8080"):
        Ok(p)    => print("listening on {p}")
        Err(msg) => print("error: {msg}")
