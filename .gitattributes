# Every text file is kept with Unix line ends, on Windows too, so that
# `zeno format --check` and the tests see the same bytes everywhere.
* text=auto eol=lf

# Typed at a corner program as it is, carriage returns and all.
tools/targets/*.stdin -text

# Files a corner program reads, kept byte for byte: one is not UTF-8,
# one holds a zero byte.
tools/targets/*.bytes -text
tools/targets/*.nul -text
