# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
provides=('zeno')
conflicts=('zeno')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/partham20/zeno-lang/releases/download/v0.2.0/zeno-0.2.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('42b8e96c177ea27873ded9c04120e963219bb405bbff5dbe644fb167e5e8e095')
source_aarch64=("https://github.com/partham20/zeno-lang/releases/download/v0.2.0/zeno-0.2.0-linux-arm64.tar.gz")
sha256sums_aarch64=('d8f202e3735d57788a3c582e194c6d2de1b064570ef1c0c543bc5c397add22c1')
source_armv7h=("https://github.com/partham20/zeno-lang/releases/download/v0.2.0/zeno-0.2.0-linux-armv7.tar.gz")
sha256sums_armv7h=('7afafd69d2a062fd5062b70734bbfb20e287be44f0461d56a924808cc79e3361')
source_armv6h=("https://github.com/partham20/zeno-lang/releases/download/v0.2.0/zeno-0.2.0-linux-armv6.tar.gz")
sha256sums_armv6h=('d0c8771098a6b74ceda3060f0bb588342de17c2025a9efea281461d3f5db8657')
source_i686=("https://github.com/partham20/zeno-lang/releases/download/v0.2.0/zeno-0.2.0-linux-x86.tar.gz")
sha256sums_i686=('cdf7f718c041e66d596a2e8ada4d29ac64d9abc0cdae523ff878567881dcbd13')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
