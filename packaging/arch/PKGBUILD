# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.5.2
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.2/zeno-0.5.2-linux-x86_64.tar.gz")
sha256sums_x86_64=('e1ca3b43061d091d6a5bc698046fec552417cb70252714d6b93afe74b85358d0')
source_aarch64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.2/zeno-0.5.2-linux-arm64.tar.gz")
sha256sums_aarch64=('98cf21cef15bcb306124cd576a0714fdf1151063c6c72cba8f1cff534872d3b7')
source_armv7h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.2/zeno-0.5.2-linux-armv7.tar.gz")
sha256sums_armv7h=('828232f9b9bc02442c6fdf19dc4025f28476af7a8ea454473c1e7bfb1a6ad8d6')
source_armv6h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.2/zeno-0.5.2-linux-armv6.tar.gz")
sha256sums_armv6h=('8a75d4716de52a10a4cc23f3ce5414f73aad1774d8a599719b02c328b5d5f08b')
source_i686=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.2/zeno-0.5.2-linux-x86.tar.gz")
sha256sums_i686=('bf8d2253c5ce44cfb6dc63be8503358125bee72926b0cad6e58fef5eda0f2aa8')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
