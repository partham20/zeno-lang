# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/partham20/zeno-lang/releases/download/v0.3.0/zeno-0.3.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('af69d47040527e7535d3579076c8e17d7122c88012f82f898704e9d7639939c9')
source_aarch64=("https://github.com/partham20/zeno-lang/releases/download/v0.3.0/zeno-0.3.0-linux-arm64.tar.gz")
sha256sums_aarch64=('e2313a6238b2e8cc3b29429dbea895b1a2e01793aa0f492c6fbafc3f36edc8c9')
source_armv7h=("https://github.com/partham20/zeno-lang/releases/download/v0.3.0/zeno-0.3.0-linux-armv7.tar.gz")
sha256sums_armv7h=('78f143ce620b39b91944b7eb1524fb3c88b8264d69e0fbd638b3a6829f5f81c8')
source_armv6h=("https://github.com/partham20/zeno-lang/releases/download/v0.3.0/zeno-0.3.0-linux-armv6.tar.gz")
sha256sums_armv6h=('29d49fd9dde91a9cb36457fdba06c608fbb4d2354b57ce6094687962e84e160c')
source_i686=("https://github.com/partham20/zeno-lang/releases/download/v0.3.0/zeno-0.3.0-linux-x86.tar.gz")
sha256sums_i686=('9c312d1bdd85336043e6619aa417dc57e18942646db9b41a9eff827c0d6e9703')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
