# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.7.0
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.7.0/zeno-0.7.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('2717dde867e2c049edca569f79d4a6fd6ff62d81467337180e1935e6f755b4fe')
source_aarch64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.7.0/zeno-0.7.0-linux-arm64.tar.gz")
sha256sums_aarch64=('c6a82933ff41b622aaba12b2716e797b76ca72090ff0abd0dcf4a9a92889da70')
source_armv7h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.7.0/zeno-0.7.0-linux-armv7.tar.gz")
sha256sums_armv7h=('c2b66974d1d3dc8eeba43f560ada3df88aba55de2659862613218333704b6a9e')
source_armv6h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.7.0/zeno-0.7.0-linux-armv6.tar.gz")
sha256sums_armv6h=('3db6f5f73c264df69ea0c8323ed2a26c1f80bf951348cd342096300ee4e1f580')
source_i686=("https://github.com/zeno-src/zeno-lang/releases/download/v0.7.0/zeno-0.7.0-linux-x86.tar.gz")
sha256sums_i686=('b39e6831730a1e36bf9667e6e9f0269efb5f77299a1a853ac97f3bac79b2883c')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
