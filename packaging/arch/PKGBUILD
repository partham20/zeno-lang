# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.5.1
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.1/zeno-0.5.1-linux-x86_64.tar.gz")
sha256sums_x86_64=('318e58181522b50eaf2b51aea7083bac5d0dd320e05f1a502355643d5b9a6bcd')
source_aarch64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.1/zeno-0.5.1-linux-arm64.tar.gz")
sha256sums_aarch64=('cb69d0c759f5bf437480e728e63092cea46b4528bae10d8164d484598f59256b')
source_armv7h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.1/zeno-0.5.1-linux-armv7.tar.gz")
sha256sums_armv7h=('36a44c76038e30f7aeed77a787765502f855f48090e27b8cc8ac676bae403b96')
source_armv6h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.1/zeno-0.5.1-linux-armv6.tar.gz")
sha256sums_armv6h=('68171d925ae90262e441aa48d79b47e5c865470623573b1a49a7e51aac160ca3')
source_i686=("https://github.com/zeno-src/zeno-lang/releases/download/v0.5.1/zeno-0.5.1-linux-x86.tar.gz")
sha256sums_i686=('599571cd2d390d6275d8ba67c42d8a9ef19e5d4e2fb53283ca91c59d93532ee2')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
