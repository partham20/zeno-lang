# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.6.0
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.6.0/zeno-0.6.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('202bf60f0d953d71ec1fd8a31c20ce6aed3bb5da6b0c762e67945b63b92737dc')
source_aarch64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.6.0/zeno-0.6.0-linux-arm64.tar.gz")
sha256sums_aarch64=('3ee3a119d8d2142cf42e1c09b2d37ac7d31013aaab83a3f8723ca62c29d09a51')
source_armv7h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.6.0/zeno-0.6.0-linux-armv7.tar.gz")
sha256sums_armv7h=('caae42828d28e8167da2ae0171027d30713ace099749e4b100dc7224b17e6aa1')
source_armv6h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.6.0/zeno-0.6.0-linux-armv6.tar.gz")
sha256sums_armv6h=('764bf31b4154e728194fe2ae2d88453e5c9145fb64f69d36ee5aed90d66665d8')
source_i686=("https://github.com/zeno-src/zeno-lang/releases/download/v0.6.0/zeno-0.6.0-linux-x86.tar.gz")
sha256sums_i686=('aaf1c6bd589fed30227cfd045a35192a073f8bbf0c726068f5cf03fe290b283d')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
