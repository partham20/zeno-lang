# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/partham20/zeno-lang/releases/download/v0.4.0/zeno-0.4.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('9a95ead20fce96668ced41a25c09bc9b0c2db4f0160d4c6453352e759c7ae145')
source_aarch64=("https://github.com/partham20/zeno-lang/releases/download/v0.4.0/zeno-0.4.0-linux-arm64.tar.gz")
sha256sums_aarch64=('51e2b7ceb3c0de3ae92eaa5b551ef85a568aa990d48c13d600965ad0e97ea116')
source_armv7h=("https://github.com/partham20/zeno-lang/releases/download/v0.4.0/zeno-0.4.0-linux-armv7.tar.gz")
sha256sums_armv7h=('6344f03c013418e474d4953d5f93261b057243db42655b7527304d484c53787a')
source_armv6h=("https://github.com/partham20/zeno-lang/releases/download/v0.4.0/zeno-0.4.0-linux-armv6.tar.gz")
sha256sums_armv6h=('64f5bc2370c7fd4ed2529b2590052d922e88fdb3eb3190cefccbd334ac67be74')
source_i686=("https://github.com/partham20/zeno-lang/releases/download/v0.4.0/zeno-0.4.0-linux-x86.tar.gz")
sha256sums_i686=('bfbc928270ab5d4d6dce36d854e40f03476089dc79965008b342fc6d760daa7b')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
