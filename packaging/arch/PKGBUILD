# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.8.0
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.8.0/zeno-0.8.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('5ca168e629e436c174bfe60cbaa08ae8bc24c093cfba13992aaa83ec1ff4f1f6')
source_aarch64=("https://github.com/zeno-src/zeno-lang/releases/download/v0.8.0/zeno-0.8.0-linux-arm64.tar.gz")
sha256sums_aarch64=('34eb14e1461a525ce452f4e0fddbb778c605c49c3cb8164c14ab38e07a013a72')
source_armv7h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.8.0/zeno-0.8.0-linux-armv7.tar.gz")
sha256sums_armv7h=('25bf471dea69f5ce6c4b548daade74b40af717df682899ab6662804dcb45895e')
source_armv6h=("https://github.com/zeno-src/zeno-lang/releases/download/v0.8.0/zeno-0.8.0-linux-armv6.tar.gz")
sha256sums_armv6h=('ca5f6ba89722c4972419b39183eef0ed99a1e105439c61606258a47505622e1f')
source_i686=("https://github.com/zeno-src/zeno-lang/releases/download/v0.8.0/zeno-0.8.0-linux-x86.tar.gz")
sha256sums_i686=('589aa65e1d5a5f7e78f322961cbf71883cc64d9c5a40c0f2b897b32da090db09')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
