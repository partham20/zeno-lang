# Zeno, for pacman. This file is written by tools/package.sh when a
# version is released: change that, not this.
#
#     makepkg -si
#
# Maintainer: Partha <123355647+partham20@users.noreply.github.com>
pkgname=zeno-lang-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="The Zeno programming language: checks, runs, tests, formats and compiles Zeno programs"
url="https://zeno-lang.org"
license=('MIT')
# What this package was called up to Zeno 0.2.0.
conflicts=('zeno-bin')
optdepends=('gcc: for `zeno build`'
            'clang: for `zeno build --llvm`'
            'git: for `zeno fetch`')
# The program is already built, and is not to be changed.
options=('!strip' '!debug')
arch=('x86_64' 'aarch64' 'armv7h' 'armv6h' 'i686')
source_x86_64=("https://github.com/partham20/zeno-lang/releases/download/v0.5.0/zeno-0.5.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('5c791bf9c61a4723c298e75e99c70cf07ee1b0d76df120464a3ef1bce8e35193')
source_aarch64=("https://github.com/partham20/zeno-lang/releases/download/v0.5.0/zeno-0.5.0-linux-arm64.tar.gz")
sha256sums_aarch64=('177124497bb35d39ed86e02eae33a79f0446f81d67098a7f174a50b5524ff920')
source_armv7h=("https://github.com/partham20/zeno-lang/releases/download/v0.5.0/zeno-0.5.0-linux-armv7.tar.gz")
sha256sums_armv7h=('436f5e23a69dbec4e4557f1470277ed5405151020531ee20e7ae497524367901')
source_armv6h=("https://github.com/partham20/zeno-lang/releases/download/v0.5.0/zeno-0.5.0-linux-armv6.tar.gz")
sha256sums_armv6h=('3bbeff1c4510b22e53df5f91c29c8b40a5ab92f0fa4ea05961a14bb4cc10cded')
source_i686=("https://github.com/partham20/zeno-lang/releases/download/v0.5.0/zeno-0.5.0-linux-x86.tar.gz")
sha256sums_i686=('d8c177e1f8958a1ed0013b2a250bce2c631646fa99ee8b498674069629e28c5f')

package() {
    # The folder that the archive unpacked into, whichever processor it
    # is for. The `/` at the end leaves out the archive itself, which
    # lies beside it and has a name that begins the same.
    cd "$srcdir"/zeno-$pkgver-linux-*/
    install -Dm755 zeno "$pkgdir/usr/lib/zeno/zeno"
    # Zeno built for a browser, which `zeno build --web` looks for
    # beside `zeno`.
    if [ -f zeno.wasm ]; then
        install -Dm644 zeno.wasm "$pkgdir/usr/lib/zeno/zeno.wasm"
    fi
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/zeno" "$pkgdir/usr/share/doc/zeno"
    ln -s ../lib/zeno/zeno "$pkgdir/usr/bin/zeno"
    cp -r examples editors "$pkgdir/usr/share/zeno/"
    cp -r README.md docs "$pkgdir/usr/share/doc/zeno/"
    # Arch keeps the licence of a package here.
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
