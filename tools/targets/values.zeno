# Lists, dicts, objects, enums, closures and errors.
let xs = [3, 1, 2]
xs.insert(1, 9)
print(xs, xs.pop(0), xs, xs.pop())
xs.sort()
print(xs, xs.find(2), xs.find(7), xs.slice(1), [1, 2] + [3])
let words = ["pear", "fig", "kiwi", "apple", "plum"]
words.sort(len)
print(words, [n * n for n in range(10) if n % 3 == 0], range(5, 0, -2))
print(xs.map(function(n: int) -> int { return n * 10 }), xs.filter(function(n: int) -> bool { return n > 1 }))
print(xs.reduce(function(a: int, b: int) -> int { return a + b }, 100), ["b", "a"].join("+"))
let d = ["b": 1, "a": 2]
d["c"] = 3
d["b"] = 10
print(d, len(d), d.keys(), d.values(), d.get("z"), d.get("z", 0), d.pop("a"), d, "c" in d, "q" not in d)
for k, v in d {
    print(k, v)
}
for i, c in "hé" {
    print(i, c)
}
try { print(d["nope"]) } except KeyError as e { print(e.message) }
let mixed = [1: "one", 2: "two"]
print(mixed[2], ["x": 1] == ["x": 2])

class Point {
    x: float
    y: float = 0.0
    function norm(self) -> float {
        return (self.x * self.x + self.y * self.y) ** 0.5
    }
    function moved(self, dx: float = 1.0, dy: float = 0.0) -> Point {
        return Point(self.x + dx, self.y + dy)
    }
}
let p = Point(3.0, 4.0)
print(p, p.norm(), p.moved(), p.moved(dy=2.0), Point(y=1.0, x=2.0), p == Point(3.0, 4.0))
p.x = 6.0
print(p.x, p)
let method = p.norm
print(method())

enum Shape {
    Circle(radius: float)
    Rect(w: float, h: float)
    Dot
}
function area(s: Shape) -> float {
    match s {
        case Circle(r) { return 3.0 * r * r }
        case Rect(w, h) { return w * h }
        case Dot { return 0.0 }
    }
}
print([area(Circle(1.0)), area(Rect(2.0, 3.0)), area(Dot)], Circle(2.0), Dot, Rect(w=1.0, h=2.0))
match 7 {
    case 1 { print("one") }
    case n { print("other", n) }
}

function counter() -> function() -> int {
    var n = 0
    return function() -> int {
        n += 1
        return n
    }
}
let next = counter()
next()
next()
print(next())
var makers = []
for i in range(3) {
    makers.append(function() -> int { return i * 10 })
}
print([f() for f in makers])

class Timeout {
    after: int
}
function risky(n: int) raises ValueError, Timeout {
    if n == 1 { raise ValueError("one is bad") }
    if n == 2 { raise Timeout(5) }
    if n == 3 { let z = [1][4] }
}
for n in range(4) {
    try {
        risky(n)
        print("fine", n)
    } except ValueError as e {
        print("value", e.message, e.kind)
    } except Timeout as t {
        print("timeout after", t.after, t)
    } except Error as e {
        print("other", e.kind, e.message)
    }
}
function greet(name: str, excited: bool = false, times: int = 1) -> str {
    var out = ""
    for _ in range(times) {
        out = out + (if_excited(name, excited))
    }
    return out
}
function if_excited(name: str, excited: bool) -> str {
    if excited {
        return f"Hi {name}! "
    }
    return f"Hi {name}. "
}
print(greet("Ada"), greet("Ada", times=2), greet(excited=true, name="Bo"))
let total = 1 < 2 < 3 and not (3 < 2 < 1)
print(total, 1 < 3 > 2 >= 2)
raise ValueError("the end")
