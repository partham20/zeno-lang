# Deep but allowed: 900 calls inside one another, through plain calls, methods, closures and map.
function down(n: int) -> int {
    if n == 0 { return 0 }
    return down(n - 1) + 1
}
print(down(900))
class Node {
    depth: int
    function sink(self, n: int) -> int {
        if n == 0 { return self.depth }
        return self.sink(n - 1) + 1
    }
}
print(Node(7).sink(450))
function via_map(n: int) -> int {
    if n == 0 { return 0 }
    return [n].map(function(k: int) -> int { return via_map(k - 1) + 1 })[0]
}
print(via_map(300))
function via_try(n: int) -> int {
    if n == 0 { return 0 }
    try {
        for i in range(1) {
            return via_try(n - 1) + 1
        }
    } except ValueError { return -1 }
    return -2
}
print(via_try(400))
function build(n: int) -> list[int] {
    if n == 0 { return [] }
    let rest = build(n - 1)
    rest.append(n)
    return rest
}
print(len(build(800)), sum(build(800)))
function chain(n: int) -> str {
    if n == 0 { return "" }
    return f"{n % 10}{chain(n - 1)}"
}
print(len(chain(700)))
