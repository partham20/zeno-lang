# Floats as text, and text as numbers.
import math
let nan = float("nan")
let inf = float("inf")
print(1e15, 1e16, 1e17, 123456789012345678.0, 9999999999999998.0, 9007199254740993.0, 0.0001, 0.00009999999999999999, 1e-5, 1.5e-5, 1e-7, 5e-324, 1.7976931348623157e308, 2.2250738585072014e-308)
print(1e21, 1e22, 1e23, 9.999999999999999e22, 8.41e21, 1e100, 123456.789e3, -1e-10, 4.35, 0.3, 2.0 / 3, 100 / 3, 1e16 - 2, 2.5e-8, 1.0e0, 12345678.9, 0.1 + 0.7, 5e-5, 0.5e-4)
print(nan, inf, -inf, -nan, [nan, inf, -inf, -0.0], str(nan), f"{nan} {inf} {-inf}", 1e308 * 10, -(0.0), 4.0e15, 4.5e15, 1.25e15, 123456789012345.6, 1234567890123456.7)
print(f"{0.125:.2f} {0.375:.2f} {2.675:.2f} {1.005:.2f} {1.45:.1f} {0.045:.2f} {2.5:.0f} {3.5:.0f} {-2.5:.0f} {0.5:.0f} {-0.5:.0f} {1e-7:.3f} {123.456:.0f} {0.05:.1f} {0.25:.1f} {0.35:.1f}")
print(f"{0.1:.20f} {1e21:.2f} {1e22:.0f} {1e300:.1f} {-0.0:.1f} {-0.04:.1f} {nan:.1f} {inf:.2f} {-inf:.0f} {5e-324:.5f} {1.7976931348623157e308:.0f}")
print(f"{0.1:.30f}|{1/3:.25f}|{2.5:.40f}|{123456789.123456789:.3f}|{9007199254740993:.1f}|{3:.2f}|{-3:.0f}|{true}|{9223372036854775807:.0f}")
print(f"{inf:08.2f}|{-inf:8}|{nan:06}|{-nan:6.1f}|{5:<05}|{-5:05}|{5:^05}|{-5:>6}|{5:<6}|{5:^6}|{-5:^7}|{0:x}|{-255:X}|{-5:08b}|{255:08x}|{-255:06x}")
let lowest = -9223372036854775807 - 1
print(f"{lowest:x} {lowest:b} {lowest:X} {lowest:d} {lowest:5} {9223372036854775807:x} {lowest:.1f}")
print(f"{2.5 s:8.1f}|{1500 ms:.0f}|{1.5 V:08.2f}|{-1.5 V:08.2f}|{2 s:6}|{2.5 s:<9}|{2 s:^9}|{1e20 s}|{1e15 ms}|{999999999999999 ms}|{-0.0 ms}|{0.1 s + 0.2 s}|{1.5 ms:.3f}")
print(f"{true:5}|{false:>6}|{none:>6}|{none:^7}|{[1, 2]:10}|{[1, 2]:>10}|{'é':3}|{'😀':3}|{'😀':>3}|{'😀😀😀😀':2}|{'a':^4}|{'ab':^5}|{'':3}|{'x':0}|{'x':1}")
print(f"{1.5:8}|{1.5:<8}|{1.5:^8}|{-1.5:08}|{1.0:5}|{1e16:10}|{1e-7:10}|{100:1}|{-0.0:5}|{1.5:08.3f}|{-1.5:8.3f}|{-1.5:<8.3f}|{1.5:^8.1f}|{0.0:.0f}|{0.4:.0f}|{0.6:.0f}")
print(1 s + 500 ms, 2.5 s, (2.5 s).ms, (1 ms).s, 1 s == 1000 ms, 1 s < 1001 ms, 3 * 500 ms, 500 ms * 3, 1 s / 3, 1 s / 250 ms, 10 ms / 4, -(5 ms), abs(-5 ms), 1e15 ms, 1e15 ms + 1 ms, 0.5 ms, 1.0 s, 1e300 s * 1e10, 0 ms * -1, (90 deg).rad, (1 rad).deg, 1 min, (1 h).s, (1.5 h).min)
print(1 s / 1 ms, 7 ms / 2 ms, (3 s + 3 s) / 2, 3 s - 5000 ms, min(3 s, 2 s), max(1.5 V, 2 V), min([5 ms, 3 ms, 4 ms]), 5 V == 5.0 V, 1 kV, (1 kV).V, 2 mV + 1 V)
try { print(1 s / 0 ms) } except ZeroDivisionError as e { print("1", e.message) }
try { print(1 s / 0) } except ZeroDivisionError as e { print("2", e.message) }
try { print(1 s / 0.0) } except ZeroDivisionError as e { print("3", e.message) }
print(float("inf"), float("-inf"), float("+inf"), float("Infinity"), float("-INFINITY"), float("nan"), float("NaN"), float("-nan"), float("+NAN"), float("1e5"), float(".5"), float("5."), float("+.5e-3"), float("1E5"), float("1e+5"), float("0e0"), float("-0"), float("1e400"), float("-1e400"), float("1e-400"), float("00012.50"), float("\t 1.5\n"), float("9007199254740993"), float("0.1e1"), float(".9999999999999999999999999999999999999999999999999999999999999999999999"), float("4.9406564584124654e-324"), float("2.4703282292062328e-324"), float("0.000000000000000000000000000000000000001e39"))
for text in ["", " ", "1d", "1f", "0x10", "0x1p3", "1_0", "nan(abc)", "infinit", "in", "1e", "e5", "1e+", "--1", "+-1", "1 2", "1,5", ".", "+", "-", "1.2.3", "١٢", "Inf inity", "１", "1e5.0", "∞", "NaNx", "0b1", "1L", "1.e", ".e1", "+.", "1\0", "\0"] {
    try { print(text, float(text)) } except ValueError as e { print("no:", e.message) }
}
for text in ["12", " 12 ", "+5", "-5", "-0", "+0", "1_000", "1__0", "_1_", "9223372036854775807", "-9223372036854775808", "00012", "\t7\n", "\r\n8\r\n", "0_0", "+_5", "-_5", "5_", "0000000000000000000000000000000000000001"] {
    try { print(int(text)) } except ValueError as e { print("no:", e.message) }
}
for text in ["", " ", "_", "+", "-", "9223372036854775808", "-9223372036854775809", "0x10", "1e3", "1.0", " 12", "12", " 12", "12　", "١٢", "１２", "+-1", "--1", "1 2", "12a", "a12", "0b1", "0o7", "1,000", "٣", "¹", "12 ", "²", "1\n2", "+ 1", "- 1", "__", "+_", "১"] {
    try { print(int(text)) } except ValueError as e { print("no:", e.message) }
}
print(str(1.0), str(-1.5e-9), str(100), str(true), str(none), str("x"), str([1.0, "a", none, true]), str(5 ms), str(1.5), 1.0, 2.50, 1e2, 12e-1, 1.0e-2)
print(math.pi * 1e10, math.e * 10, 2 ** 0.5 * 2 ** 0.5, 1 / 3 * 3, 1e-320, 1e-323, 3e-324, 123e-310, 0.1 * 0.1, 1.1 + 2.2, 3.3 * 3, 1e15 + 0.3, 1e15 + 0.5, 0.000123, 0.00012345678901234567)
# A float that lies exactly between two shortest texts takes the even one (decision 24.21).
print(1e15 + 0.25, 1e15 + 0.75, 8388608.0 + 1.0 / 1024.0, 8388608.0 + 3.0 / 1024.0, 70368744177664.0 + 0.125, 70368744177664.0 + 0.375)
print(f"{0.125:.2f} {0.375:.2f} {2.5:.0f} {3.5:.0f} {1e15 + 0.25:.1f}")
# A power of two has the float below it half as far away as the float above, so the fewest digits that name it are now and then not the ones rounded from it (decision 53.2).
print(5.684341886080802e-14, 7.120236347223045e-307, 5.641232424577593e-278, 8.209073602596753e-289)
var power = 1.0
for i in range(1023) {
    power = power * 2.0
    print(power)
}
power = 1.0
for i in range(1074) {
    power = power / 2.0
    print(power)
}
