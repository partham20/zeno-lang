print("a😀b".replace("", "-"), "😀".replace("😀", ""), "aaa".replace("aa", "b"), "abc".replace("b", ""), "abc".replace("x", "y"), "".replace("a", "b"), "a.b.c".replace(".", ".."), "$1 \\1 $& %s {0}".replace("$", "$$"), "aXbXc".replace("X", "$&"), "a|b".replace("|", "\\"), "tab\there".replace("\t", "\\t"), "ééé".replace("é", "e" + char(769)))
print("abc".starts_with(""), "abc".ends_with(""), "".starts_with(""), "abc".starts_with("abcd"), "😀a".starts_with("😀"), "a😀".ends_with("😀"), "abc".ends_with("bc"), "abc".starts_with("b"), "é".starts_with("e"), ("e" + char(769)).starts_with("e"))
print("abcabc".find("c"), "abcabc".find("ca"), "abc".find("abcd"), "".find(""), "".find("a"), "😀😀a".find("a"), "😀😀a".find("😀a"), "aé😀".find("😀"), "a.b".find("."), "a*b".find("*"), "a\\b".find("\\"))
