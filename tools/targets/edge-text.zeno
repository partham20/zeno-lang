print(len(astral), astral[1], astral[3], astral.find("b"), astral.find("𝄞"), astral.find(""), astral.slice(1, 4), astral.slice(4), astral.upper(), astral.slice(5, 5), astral.slice(0, 0))
for i, c in astral { print(i, c, c.code(), len(c)) }
for c in "e" + char(769) + "é" { print(c.code()) }
print("😀" in astral, "😀b" in astral, "" in astral, "x" in "", "" in "", "b𝄞" not in astral)
print(char(65535) < "😀", "😀" < char(65535), char(65535) < char(65536), "😀" > "z", "" < "😀", "😀" < "😀a", "a😀" < "a" + char(65535), "é" < "e" + char(769), "Z" < "a", "a" < "B", "abc" < "abcd", "ab" + char(1) < "ab ")
let words = ["😀", char(65535), "z", "é", "e" + char(769), "Z", "", "a", "𝄞", char(57344), char(65536), "aa", "a😀", "a" + char(65535)]
words.sort()
print([w.code() for w in words if len(w) == 1], words.find("a😀"), words.find("a" + char(65535)))
words.sort(len)
print([len(w) for w in words])
