# What interfaces left out until 0.8 (decisions 58.20 to 58.22).
# Defaults on the functions of an interface, of every kind a default
# there can be, and a call through the interface and on the object
# that mean the same. A function that takes out what its object owns,
# standing for one of an interface, called through it by the owner,
# and by a class through its own interface. An `owned interface`, in
# an owned list, as a parameter that looks and one that takes, and as
# a field. Every build prints what `zeno run` prints, and a build with
# no collector leaves nothing.

enum Mode {
    Slow
    Fast
}

interface Motor {
    function spin(self, speed: int = 1_000, wait: ms = 5 ms, mode: Mode = Fast, label: str = "m", back: bool = false, trim: float = -0.5, turns: int = -3)
    function name(self, prefix: str or none = none) -> str
    function stop(self, after: ms)
}

class Fan is Motor {
    id: int

    function spin(self, speed: int = 1000, wait: ms = 5 ms, mode: Mode = Mode.Fast, label: str = "m", back: bool = false, trim: float = -0.5, turns: int = -3) {
        print(f"{self.name()} {speed} {wait} {mode} {label} {back} {trim} {turns}")
    }

    function name(self, prefix: str or none = none) -> str {
        if prefix is none {
            return f"fan {self.id}"
        }
        return f"{prefix} fan {self.id}"
    }

    # A default of its own where the interface writes none is the
    # class's business: through a `Motor` every argument is given.
    function stop(self, after: ms = 10 ms) {
        print(f"{self.name()} stops after {after}")
    }
}

class Pump is Motor {
    flow: int

    function spin(self, speed: int = 1000, wait: ms = 5 ms, mode: Mode = Fast, label: str = "m", back: bool = false, trim: float = -0.5, turns: int = -3) {
        print(f"{self.name()} {speed} {wait} {mode} {label} {back} {trim} {turns}")
    }

    function name(self, prefix: str or none = none) -> str {
        return f"pump {self.flow}"
    }

    function stop(self, after: ms) {
        print(f"{self.name()} stops after {after}")
    }

    function prime(self, times: int = 2) -> int {
        return self.flow * times
    }
}

function drive(motor: Motor) {
    motor.spin()
    motor.spin(7)
    motor.spin(wait=2000 ms, back=true, mode=Slow)
    print(motor.name(), motor.name("big"))
    motor.stop(1 ms)
}

let motors: list[Motor] = [Fan(1), Pump(3)]
for motor in motors {
    drive(motor)
}
let fan = Fan(2)
fan.spin()
fan.spin(label="direct")
fan.stop()
let pump = Pump(4)
print(pump.prime(), pump.prime(3), pump.name("x"))

# Taking out, through an interface (58.21).
class Task {
    name: str
    steps: list[int]
}

interface Pile {
    function take_last(self) -> Task
    function size(self) -> int
}

class Stack is Pile {
    tasks: list[Task]

    function take_last(self) -> Task {
        return self.tasks.pop()
    }

    function size(self) -> int {
        return len(self.tasks)
    }
}

class Queue is Pile {
    tasks: list[Task]

    function take_last(self) -> Task {
        return self.tasks.pop(0)
    }

    function size(self) -> int {
        return len(self.tasks)
    }
}

function drain(pile: take Pile) -> int {
    var steps = 0
    while pile.size() > 0 {
        let task = pile.take_last()
        steps += len(task.steps)
        print(task.name)
    }
    return steps
}

function make(n: int) -> list[Task] {
    var tasks: list[Task] = []
    for i in range(n) {
        tasks.append(Task(f"task {i}", [i, i * 2]))
    }
    return tasks
}

print(drain(Stack(make(3))), drain(Queue(make(2))))
var piles: list[Pile] = [Stack(make(2)), Queue(make(2))]
print(piles[1].take_last().name)
print(piles[0].take_last().name)
print(piles[0].size())
var rounds = 0
for round in range(1000) {
    var pile: Pile = Stack(make(3))
    if round % 2 == 0 {
        pile = Queue(make(3))
    }
    rounds += len(pile.take_last().steps)
}
print(rounds)

# A class that calls through its own interface.
interface Tree {
    function count(self) -> int
    function strip(self) -> int
}

class Node is Tree {
    kids: list[Tree]

    function count(self) -> int {
        var n = 1
        for kid in self.kids {
            n += kid.count()
        }
        return n
    }

    function strip(self) -> int {
        var gone = 0
        while len(self.kids) > 0 {
            var kid = self.kids.pop()
            gone += kid.strip() + 1
        }
        return gone
    }
}

class Leaf is Tree {
    function count(self) -> int {
        return 1
    }

    function strip(self) -> int {
        return 0
    }
}

let tree = Node([Node([Leaf(), Leaf()]), Leaf(), Node([Node([Leaf()])])])
print(tree.count())
print(tree.strip())
print(tree.count())

# An `owned interface` (58.22): with a collector too, each object that
# is a `Shape` has one owner, which frees it.
owned class Point {
    x: int
    y: int
}

owned interface Shape {
    function area(self) -> float
    function grow(self, by: float)
    function move_to(self, at: take Point)
}

owned class Circle is Shape {
    radius: float
    centre: Point

    function area(self) -> float {
        return 3.0 * self.radius * self.radius
    }

    function grow(self, by: float) {
        self.radius = self.radius * by
    }

    # It replaces the point its object owns, so a call through a
    # `Shape` is for the owner of the shape.
    function move_to(self, at: take Point) {
        self.centre = at
    }
}

owned class Square is Shape {
    side: float

    function area(self) -> float {
        return self.side * self.side
    }

    function grow(self, by: float) {
        self.side = self.side * by
    }

    function move_to(self, at: take Point) {
    }
}

owned class Frame {
    inside: Shape
    spare: Shape or none = none
}

function total(shapes: owned list[Shape]) -> float {
    var sum = 0.0
    for shape in shapes {
        sum += shape.area()
    }
    return sum
}

function frame(shape: take Shape) -> Frame {
    return Frame(shape)
}

function doubled(shape: Shape) -> float {
    shape.grow(2.0)
    return shape.area()
}

var shapes: owned list[Shape] = [Circle(1.0, Point(0, 0)), Square(2.0)]
shapes.append(Square(1.0))
print(total(shapes))
print(doubled(shapes[0]))
shapes[0].move_to(Point(3, 4))
let framed = frame(Circle(0.5, Point(1, 1)))
print(framed.inside.area())
framed.spare = shapes.pop()
framed.inside.move_to(Point(5, 5))
print(framed)
print(shapes)
for i in range(1000) {
    var shape: Shape = Square(float(i))
    if i % 3 == 0 {
        shape = Circle(1.0, Point(i, i))
    }
    shape.move_to(Point(0, i))
    shapes.append(shape)
    let gone = shapes.pop(0)
}
print(len(shapes), total(shapes))
