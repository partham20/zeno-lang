# Names that begin with a capital letter are constants in Ruby.
var Total = 0
class Point {
    X: int
    Y: int
    function Sum(self) -> int { return self.X + self.Y }
}
function Twice(N: int) -> int { return N * 2 }
let Origin = Point(1, 2)
Total += Twice(Origin.Sum())
for Item in [1, 2, 3] { Total += Item }
print(Total, Origin, Twice)
# Text that Ruby, Dart, Kotlin and Lua would read as more than text.
let money = "$5 and ${x} and $x and #{y} and #$z and #@w and %d and \\n and [[x]] and --"
print(money, len(money))
print("a\tb", "q\"q", "back\\slash", f"{money.slice(0, 2)}$", f"#{{1 + 1}}", f"${{2}}")
# A function made in each round of a loop keeps that round's variables.
var made = []
var round = 0
while round < 4 {
    let mine = round * round
    var count = 0
    made.append(function() -> int {
        count += 1
        return mine + count
    })
    round += 1
}
print([f() for f in made], [f() for f in made])
var each = []
for a, b in [10, 20, 30] {
    var seen = a
    while seen < 2 {
        let now = seen + b
        each.append(function() -> int { return now })
        seen += 1
    }
}
print([f() for f in each])
# `break`, `continue` and `return` from inside a `try`, in a loop, in a function.
function hunt(limit: int) -> str {
    var trail = ""
    for i in range(10) {
        try {
            if i == 1 { continue }
            if i == limit { return trail + "!" }
            if i == 6 { break }
            var j = 0
            while true {
                try {
                    j += 1
                    if j == 2 { continue }
                    if j > 3 { break }
                    if i == 4 and j == 3 { raise ValueError("four") }
                    trail += str(j)
                } except IndexError as e {
                    trail += "never"
                }
            }
            trail += "."
        } except ValueError as e {
            trail += "<" + e.message + ">"
            if limit == 5 { continue }
            return trail + "?"
        }
    }
    return trail
}
print(hunt(3), hunt(5), hunt(9))
function deep(n: int) -> int {
    try {
        if n == 0 { raise KeyError("bottom") }
        return deep(n - 1) + 1
    } except KeyError as e {
        if n < 3 { raise e }
        return n * 100
    }
}
print(deep(2 + 3))
try { deep(1) } except KeyError as e { print(e.message) }
