class new_ {
    new: int
    delete: int = 2
    class_: int = 3
    this: int = 4
    constructor: int = 5
    prototype: int = 6
    __proto__: int = 7
    toString: int = 8
    length: int = 9
    hashCode: int = 10
    __init__: int = 11
    __dict__: int = 12
    __class__: int = 13
    type: int = 14
    default: int = 15
    function static(self, void: int, null: int = 1) -> int {
        return self.new + void + null + self.toString + self.__class__
    }
    function valueOf(self) -> int {
        return self.constructor * self.prototype
    }
    function equals(self, other: int) -> bool {
        return other == self.new
    }
    function __str__(self) -> str {
        return "not used"
    }
    function hasOwnProperty(self, x: int) -> int {
        return x
    }
}
let o = new_(1)
print(o, o.static(5), o.static(void=5, null=7), o.static(null=7, void=5), o.valueOf(), o.equals(1), o.__str__(), o.hasOwnProperty(3), o.toString, o.__proto__, o.__class__, o.default)
o.constructor = 50
o.__proto__ = 70
o.length += 1
print(o, o == new_(1), o == new_(1, constructor=50, __proto__=70, length=10))
enum struct_ {
    None_
    null_(new: int, delete: str)
    Some_(value: int)
    Ok_
}
function describe(u: struct_) -> str {
    match u {
        case None_ { return "none case" }
        case null_(new, delete) { return f"null {new} {delete}" }
        case Some_(value) { return f"some {value}" }
        case Ok_ { return "ok" }
    }
}
print(describe(None_), describe(null_(1, "x")), describe(Some_(2)), describe(Ok_), null_(delete="d", new=9), [None_, Ok_, Some_(1)])
function typeof_(new: int, this: int = 2, arguments_: int = 3) -> int {
    let eval_ = new * this
    var undefined_ = eval_ + arguments_
    undefined_ += 1
    return undefined_
}
print(typeof_(1), typeof_(this=5, new=2), typeof_(1, 2, arguments_=10))
let dict_ = ["__proto__": 1, "constructor": 2, "toString": 3, "hasOwnProperty": 4, "length": 5, "": 6]
print(dict_, dict_["__proto__"], dict_.get("valueOf"), "toString" in dict_, "valueOf" in dict_, dict_.keys(), len(dict_))
dict_["valueOf"] = 7
print(dict_.pop("__proto__"), dict_)
