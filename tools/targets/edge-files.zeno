# Files and typed lines at their edges.
import files
from program import arguments
print(arguments(), len(arguments()))
let path = "zeno-targets-edge-files.txt"
function attempt(what: str, action: function() -> str) {
    try {
        print(what, "->", action())
    } except FileError as e {
        print(what, "-> FileError:", e.message)
    }
}
attempt("read missing", function() -> str { return files.read("zeno-targets-no-such-file.txt") })
attempt("read folder", function() -> str { return files.read(".") })
attempt("read empty name", function() -> str { return files.read("") })
attempt("remove missing", function() -> str {
    files.remove("zeno-targets-no-such-file.txt")
    return "removed"
})
attempt("remove folder", function() -> str {
    files.remove(".")
    return "removed"
})
attempt("write folder", function() -> str {
    files.write(".", "x")
    return "written"
})
attempt("write in missing folder", function() -> str {
    files.write("zeno-targets-no-such-folder/x.txt", "x")
    return "written"
})
attempt("append in missing folder", function() -> str {
    files.append("zeno-targets-no-such-folder/x.txt", "x")
    return "written"
})
attempt("write empty name", function() -> str {
    files.write("", "x")
    return "written"
})
print(files.exists("."), files.exists(""), files.exists("zeno-targets-no-such-file.txt"), files.exists("edge-files.bytes"), files.exists("edge-files.zeno"))
attempt("read not text", function() -> str { return files.read("edge-files.bytes") })
attempt("read zero byte", function() -> str { return files.read("edge-files.nul") })
# What is written is what is read: nothing added, nothing changed.
let texts = ["", "\n", "no end", "a\r\nb\r\n", "\r", "tab\tand space ", "é😀தமிழ்" + char(8232) + char(65279), "\n\n\n", " "]
for text in texts {
    files.write(path, text)
    let back = files.read(path)
    print(back == text, len(back), back.lines())
}
files.write(path, "one")
files.append(path, "")
files.append(path, "\ntwo")
files.append(path, "\r\n")
files.write(path + ".2", "")
files.append(path + ".2", "made by append")
print(files.read(path) == "one\ntwo\r\n", files.read(path + ".2"), files.read(path).lines())
files.write(path, "second write is shorter")
files.write(path, "short")
print(files.read(path))
files.remove(path)
files.remove(path + ".2")
print(files.exists(path), files.exists(path + ".2"))
attempt("remove twice", function() -> str {
    files.remove(path)
    return "removed"
})
# A file in pieces (decision 59.6): a thousand lines written by a
# Writer, every seventh with a Windows line end and the last with none.
function write_lines(at: str) raises FileError {
    let out = files.write_to(at)
    for i in range(1000) {
        out.write(f"line {i}")
        if i == 999 {
            break
        }
        out.write(if_seventh(i))
    }
}
function if_seventh(i: int) -> str {
    if i % 7 == 0 {
        return "\r\n"
    }
    return "\n"
}
write_lines(path)
var count = 0
var total = 0
var last = ""
if true {
    let source = files.read_from(path)
    for line in source {
        count += 1
        total += len(line)
        last = line
    }
}
print("by for:", count, total, last, files.read(path).lines() == read_all(path))
function read_all(at: str) -> list[str] raises FileError {
    let source = files.read_from(at)
    var lines: list[str] = []
    while true {
        let line = source.read_line()
        if line is none {
            break
        }
        lines.append(line)
    }
    return lines
}
# The same file opened again at once: the first was closed.
for round in range(3) {
    let again = files.read_from(path)
    print("round", round, again.read_line(), again.read_line())
}
files.remove(path)
print("removed:", not files.exists(path))
# A file whose last line has an end, an empty one, and empty lines.
let shapes = ["a\n", "", "\n", "\n\n", "x\r\n\r\ny", "\r"]
for shape in shapes {
    files.write(path, shape)
    print([shape], read_all(path), shape.lines() == read_all(path))
}
# Bytes in pieces, across the end.
var all: list[u8] = []
for b in range(256) {
    all.append(u8(b))
}
if true {
    let out = files.write_to(path)
    out.write_bytes(all)
    out.write_bytes([])
    out.write("tail")
}
if true {
    let source = files.read_from(path)
    print("no bytes:", source.read_bytes(0))
    var sizes: list[int] = []
    while true {
        let piece = source.read_bytes(100)
        sizes.append(len(piece))
        if len(piece) == 0 {
            break
        }
    }
    print("pieces:", sizes, source.read_bytes(5), source.read_line())
    try {
        print(source.read_bytes(-1))
    } except ValueError as e {
        print("ValueError:", e.message)
    }
}
# Added to the end, and a writer that begins empty.
files.write(path, "first\n")
if true {
    let more = files.append_to(path)
    more.write("second\n")
    more.write("é😀தமிழ்\n")
}
print(read_all(path))
if true {
    let fresh = files.write_to(path)
}
print("emptied:", [files.read(path)])
# What cannot be opened, and a line that is not text.
attempt("read_from missing", function() -> str {
    let source = files.read_from("zeno-targets-no-such-file.txt")
    return "opened"
})
attempt("read_from folder", function() -> str {
    let source = files.read_from(".")
    return "opened"
})
attempt("write_to in missing folder", function() -> str {
    let out = files.write_to("zeno-targets-no-such-folder/x.txt")
    return "opened"
})
attempt("append_to folder", function() -> str {
    let out = files.append_to(".")
    return "opened"
})
attempt("read_line not text", function() -> str {
    let source = files.read_from("edge-files.bytes")
    while true {
        let line = source.read_line()
        if line is none {
            return "the end"
        }
    }
})
attempt("read_line zero byte", function() -> str {
    let source = files.read_from("edge-files.nul")
    let line = source.read_line()
    return "read"
})
# A file that grows after its end was met: the end is where the file
# ends at that moment, and a later read looks again (59.6).
function grow(at: str) raises FileError, ValueError {
    let out = files.write_to(at)
    let source = files.read_from(at)
    print("grow", source.read_line(), source.read_bytes(3))
    out.write("one\n")
    print("grow", source.read_line(), source.read_line())
    out.write("tw")
    print("grow", source.read_bytes(5), source.read_bytes(1))
    out.write("o\nthree")
    for piece in source {
        print("grow for", [piece])
    }
    out.write("\nfour\n")
    print("grow", [source.read_line()], source.read_line(), source.read_line())
    out.write_bytes([0x66, 0x69, 0x76, 0x65])
    for piece in source {
        print("grow for", [piece])
    }
    print("grow", source.read_bytes(2))
}
grow(path)
files.remove(path)
# A sleep of no time, or less, is no sleep.
import time
time.sleep(0 ms)
time.sleep(-5 s)
# Typed lines.
var n = 0
var line = input("first> ")
while line is not none {
    n += 1
    print(n, len(line), f"[{line}]", [line], line.strip() == line, line.split())
    line = input()
}
print(input("after the end> "), input())
